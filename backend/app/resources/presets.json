{
  "version": 1,
  "algorithms": [
    {
      "id": "sft",
      "label": "SFT 监督微调",
      "job_type": "sft",
      "frameworks": ["llamafactory"],
      "dataset_kinds": ["sft_alpaca", "sft_sharegpt"],
      "summary": "在指令数据上做有监督微调，是所有后训练的起点。",
      "doc": "LLaMA-Factory stage=sft。LoRA 适合快速迭代与小显存；full 需要 ZeRO-3 或多卡。"
    },
    {
      "id": "dpo",
      "label": "DPO 直接偏好优化",
      "job_type": "sft",
      "frameworks": ["llamafactory", "trl"],
      "dataset_kinds": ["dpo_pairs"],
      "summary": "用成对偏好数据直接优化策略，无需奖励模型与采样。",
      "doc": "LLaMA-Factory stage=dpo，pref_loss=sigmoid 即标准 DPO；pref_loss=orpo/simpo 切换到对应变体。beta 越大越保守。"
    },
    {
      "id": "kto",
      "label": "KTO",
      "job_type": "sft",
      "frameworks": ["llamafactory", "trl"],
      "dataset_kinds": ["kto_pairs"],
      "summary": "只需要「好/坏」二元标签的偏好对齐方法。",
      "doc": "数据成本比 DPO 低，适合只有点赞/点踩反馈的场景。"
    },
    {
      "id": "orpo",
      "label": "ORPO",
      "job_type": "sft",
      "frameworks": ["llamafactory"],
      "dataset_kinds": ["dpo_pairs"],
      "summary": "把 SFT 与偏好优化合成一个阶段，省掉参考模型。",
      "doc": "stage=dpo + pref_loss=orpo，不需要 reference model，显存占用更低。"
    },
    {
      "id": "simpo",
      "label": "SimPO",
      "job_type": "sft",
      "frameworks": ["llamafactory"],
      "dataset_kinds": ["dpo_pairs"],
      "summary": "长度归一化的无参考偏好优化。",
      "doc": "stage=dpo + pref_loss=simpo，通常配合较大的 beta（2.0~2.5）与 gamma。"
    },
    {
      "id": "grpo",
      "label": "GRPO",
      "job_type": "rl",
      "frameworks": ["verl", "trl"],
      "dataset_kinds": ["verl_parquet", "harbor_tasks"],
      "summary": "组相对策略优化：同一 prompt 采样一组回复，用组内均值做基线，无需 critic。",
      "doc": "verl: algorithm.adv_estimator=grpo，rollout.n 即组大小（建议 8~16）。TRL: GRPOTrainer，num_generations 对应组大小。"
    },
    {
      "id": "dapo",
      "label": "DAPO",
      "job_type": "rl",
      "frameworks": ["verl"],
      "dataset_kinds": ["verl_parquet", "harbor_tasks"],
      "summary": "解耦裁剪 + 动态采样的 GRPO 改进版，长思维链 RL 更稳。",
      "doc": "在 GRPO 基础上：clip_ratio_low/high 解耦（0.2/0.28）、filter_groups 动态过滤全对/全错组、token-level 损失聚合、超长回复软惩罚。"
    },
    {
      "id": "gspo",
      "label": "GSPO",
      "job_type": "rl",
      "frameworks": ["trl"],
      "dataset_kinds": ["verl_parquet", "harbor_tasks"],
      "summary": "序列级重要性采样的 GRPO 变体，MoE 训练更稳定。",
      "doc": "TRL: GRPOConfig(importance_sampling_level=\"sequence\")。"
    },
    {
      "id": "ppo",
      "label": "PPO",
      "job_type": "rl",
      "frameworks": ["verl"],
      "dataset_kinds": ["verl_parquet"],
      "summary": "经典 actor-critic RLHF，需要额外的 critic 与 reward model。",
      "doc": "verl: algorithm.adv_estimator=gae，需要配置 critic 相关资源，显存占用最高。"
    },
    {
      "id": "rloo",
      "label": "RLOO",
      "job_type": "rl",
      "frameworks": ["verl", "trl"],
      "dataset_kinds": ["verl_parquet"],
      "summary": "留一法基线的 REINFORCE，实现简单、方差较低。",
      "doc": "verl: adv_estimator=rloo；TRL: RLOOTrainer。"
    },
    {
      "id": "reinforce_plus_plus",
      "label": "REINFORCE++",
      "job_type": "rl",
      "frameworks": ["verl"],
      "dataset_kinds": ["verl_parquet"],
      "summary": "带全局基线与归一化技巧的 REINFORCE。",
      "doc": "verl: adv_estimator=reinforce_plus_plus 或 reinforce_plus_plus_baseline。"
    },
    {
      "id": "remax",
      "label": "ReMax",
      "job_type": "rl",
      "frameworks": ["verl"],
      "dataset_kinds": ["verl_parquet"],
      "summary": "用贪心解码作为基线的方差缩减方法。",
      "doc": "verl: adv_estimator=remax，需要额外一次贪心采样。"
    }
  ],
  "sft_presets": [
    {
      "id": "lora-quick",
      "label": "LoRA 快速验证",
      "description": "单卡即可跑通，用于确认数据与模板是否正确。",
      "recommended_gpus": 1,
      "config": {
        "finetuning_type": "lora",
        "lora": { "rank": 8, "alpha": 16, "dropout": 0.05, "target": "all" },
        "cutoff_len": 2048,
        "learning_rate": 0.0001,
        "num_train_epochs": 3.0,
        "per_device_train_batch_size": 1,
        "gradient_accumulation_steps": 8,
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0.1,
        "compute_type": "bf16",
        "gradient_checkpointing": true,
        "deepspeed_stage": "none",
        "logging_steps": 10,
        "save_steps": 500,
        "max_samples": 1000
      }
    },
    {
      "id": "lora-standard",
      "label": "LoRA 标准训练",
      "description": "常用生产配置：rank 32、全量数据、余弦调度。",
      "recommended_gpus": 1,
      "config": {
        "finetuning_type": "lora",
        "lora": { "rank": 32, "alpha": 64, "dropout": 0.05, "target": "all" },
        "cutoff_len": 4096,
        "learning_rate": 0.00005,
        "num_train_epochs": 3.0,
        "per_device_train_batch_size": 2,
        "gradient_accumulation_steps": 8,
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0.05,
        "compute_type": "bf16",
        "gradient_checkpointing": true,
        "deepspeed_stage": "none",
        "logging_steps": 10,
        "save_steps": 500
      }
    },
    {
      "id": "full-zero3",
      "label": "全参微调 (ZeRO-3)",
      "description": "多卡全参数微调，显存换速度，适合 7B 以上模型。",
      "recommended_gpus": 8,
      "config": {
        "finetuning_type": "full",
        "cutoff_len": 4096,
        "learning_rate": 0.00001,
        "num_train_epochs": 2.0,
        "per_device_train_batch_size": 1,
        "gradient_accumulation_steps": 16,
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0.03,
        "compute_type": "bf16",
        "gradient_checkpointing": true,
        "deepspeed_stage": "zero3",
        "logging_steps": 5,
        "save_steps": 200
      }
    },
    {
      "id": "dpo-lora",
      "label": "DPO · LoRA",
      "description": "偏好对齐默认配置，学习率显著低于 SFT。",
      "recommended_gpus": 1,
      "config": {
        "stage": "dpo",
        "finetuning_type": "lora",
        "lora": { "rank": 16, "alpha": 32, "dropout": 0.05, "target": "all" },
        "cutoff_len": 4096,
        "learning_rate": 0.000005,
        "num_train_epochs": 2.0,
        "per_device_train_batch_size": 1,
        "gradient_accumulation_steps": 8,
        "pref_beta": 0.1,
        "pref_loss": "sigmoid",
        "compute_type": "bf16",
        "logging_steps": 10,
        "save_steps": 500
      }
    }
  ],
  "rl_presets": [
    {
      "id": "verl-grpo-standard",
      "label": "verl · GRPO 标准",
      "description": "单机多卡 GRPO，vLLM rollout，组大小 8。",
      "framework": "verl",
      "algorithm": "grpo",
      "recommended_gpus": 8,
      "config": {
        "max_prompt_length": 1024,
        "max_response_length": 2048,
        "train_batch_size": 64,
        "mini_batch_size": 32,
        "learning_rate": 0.000001,
        "clip_ratio": 0.2,
        "use_kl_loss": true,
        "kl_loss_coef": 0.001,
        "loss_agg_mode": "token-mean",
        "rollout": { "backend": "vllm", "n": 8, "temperature": 1.0, "gpu_memory_utilization": 0.6 },
        "save_freq": 20,
        "test_freq": 20
      }
    },
    {
      "id": "verl-dapo",
      "label": "verl · DAPO",
      "description": "解耦裁剪 + 动态采样 + 超长惩罚，长 CoT 首选。",
      "framework": "verl",
      "algorithm": "dapo",
      "recommended_gpus": 8,
      "config": {
        "max_prompt_length": 2048,
        "max_response_length": 8192,
        "train_batch_size": 128,
        "mini_batch_size": 32,
        "learning_rate": 0.000001,
        "clip_ratio_low": 0.2,
        "clip_ratio_high": 0.28,
        "loss_agg_mode": "token-mean",
        "use_kl_loss": false,
        "use_kl_in_reward": false,
        "filter_groups_enable": true,
        "filter_groups_metric": "acc",
        "filter_groups_max_num_gen_batches": 10,
        "enable_overlong_buffer": true,
        "overlong_buffer_len": 512,
        "overlong_penalty_factor": 1.0,
        "rollout": { "backend": "vllm", "n": 16, "temperature": 1.0, "gpu_memory_utilization": 0.7 },
        "save_freq": 20,
        "test_freq": 20
      }
    },
    {
      "id": "trl-grpo-harbor",
      "label": "TRL · GRPO + Harbor 环境",
      "description": "以 Harbor 任务树作为 agentic RL 环境，奖励来自任务 verifier。",
      "framework": "trl",
      "algorithm": "grpo",
      "recommended_gpus": 4,
      "config": {
        "max_prompt_length": 2048,
        "max_response_length": 2048,
        "train_batch_size": 8,
        "learning_rate": 0.000001,
        "rollout": { "backend": "vllm", "n": 8, "gpu_memory_utilization": 0.5 },
        "harbor": {
          "enabled": true,
          "harness": "bash",
          "environment_type": "docker",
          "num_tasks": 64,
          "max_tool_calling_iterations": 25
        }
      }
    },
    {
      "id": "trl-gspo",
      "label": "TRL · GSPO",
      "description": "序列级重要性采样，MoE / 大模型更稳。",
      "framework": "trl",
      "algorithm": "gspo",
      "recommended_gpus": 4,
      "config": {
        "max_prompt_length": 1024,
        "max_response_length": 2048,
        "train_batch_size": 16,
        "learning_rate": 0.000001,
        "rollout": { "backend": "vllm", "n": 8, "gpu_memory_utilization": 0.5 }
      }
    }
  ],
  "verify_presets": [
    {
      "id": "oracle-selfcheck",
      "label": "Oracle 自检",
      "description": "跑 solution/solve.sh，确认任务本身与测试脚本自洽。奖励应为 1.0。",
      "config": { "agent": "oracle", "model": "", "n_concurrent": 8, "n_attempts": 1 }
    },
    {
      "id": "nop-baseline",
      "label": "Nop 基线",
      "description": "什么都不做的基线，用于确认任务不会「不做也能过」。奖励应为 0。",
      "config": { "agent": "nop", "model": "", "n_concurrent": 8, "n_attempts": 1 }
    },
    {
      "id": "claude-code-pass1",
      "label": "Claude Code · pass@1",
      "description": "单次尝试评测，需要 ANTHROPIC_API_KEY。",
      "config": {
        "agent": "claude-code",
        "model": "anthropic/claude-sonnet-4-5",
        "n_concurrent": 8,
        "n_attempts": 1,
        "agent_env": { "ANTHROPIC_API_KEY": "" }
      }
    },
    {
      "id": "codex-pass4",
      "label": "Codex · pass@4",
      "description": "每个任务尝试 4 次，统计 pass@1/2/4。",
      "config": {
        "agent": "codex",
        "model": "openai/gpt-5.1-codex",
        "n_concurrent": 16,
        "n_attempts": 4,
        "agent_env": { "OPENAI_API_KEY": "" }
      }
    },
    {
      "id": "local-model-terminus",
      "label": "Terminus · 本地模型",
      "description": "用 Harbor 自带 agent 评测自己训练出来的模型（需先起 vLLM 兼容服务）。",
      "config": {
        "agent": "terminus",
        "model": "hosted_vllm/local-model",
        "n_concurrent": 8,
        "n_attempts": 1,
        "agent_env": { "OPENAI_API_BASE": "http://127.0.0.1:8000/v1", "OPENAI_API_KEY": "EMPTY" }
      }
    }
  ]
}
