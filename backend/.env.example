# PRT AI DL Factory — 后端配置样例
# 复制为 backend/.env 后按实际环境修改；所有变量都以 PRT_ 开头。

# ---------------------------------------------------------------- 服务 ---
PRT_HOST=0.0.0.0
PRT_PORT=8000
PRT_DEBUG=false
# 逗号分隔的前端来源；开发时用 * 即可
PRT_CORS_ORIGINS=*

# ---------------------------------------------------------------- 账号 ---
# 留空则首次启动时自动生成并写入 data/db/secret.key
PRT_SECRET_KEY=
PRT_ACCESS_TOKEN_TTL_MINUTES=720
# 数据目录为空时自动创建的第一个管理员
PRT_BOOTSTRAP_ADMIN_EMAIL=admin@prt.local
PRT_BOOTSTRAP_ADMIN_PASSWORD=prt-admin-2026

# ---------------------------------------------------------------- 路径 ---
# 平台自身的数据（账号、任务、数据集、日志、产物）
PRT_DATA_ROOT=./data
# 模型仓库根目录，结构为 {厂家}/{模型名}
PRT_MODELS_ROOT=/workspace/LiHanlin_Workspace/models

# 训练/评测框架的源码位置
PRT_LLAMAFACTORY_ROOT=/workspace/LiHanlin_Workspace/github/LlamaFactory
PRT_VERL_ROOT=/workspace/LiHanlin_Workspace/github/verl
PRT_TRL_ROOT=/workspace/LiHanlin_Workspace/github/trl
PRT_HARBOR_ROOT=/workspace/LiHanlin_Workspace/github/harbor

# ------------------------------------------------------------ 解释器 -----
# 每个框架各自的 python（留空则使用 PRT_PYTHON_DEFAULT）。
# 训练框架依赖很重，通常各自装在独立的 conda 环境里。
PRT_PYTHON_DEFAULT=python
PRT_LLAMAFACTORY_PYTHON=
PRT_VERL_PYTHON=
PRT_TRL_PYTHON=
PRT_HARBOR_PYTHON=

# harbor / modelscope 命令行工具
PRT_HARBOR_BIN=harbor
PRT_MODELSCOPE_BIN=/opt/miniconda3/envs/modelscope/bin/modelscope

# ---------------------------------------------------------------- 调度 ---
# 同时运行的任务数（管理员可在系统设置里覆盖）
PRT_MAX_CONCURRENT_JOBS=2
PRT_SCHEDULER_INTERVAL_SECONDS=3
PRT_MONITOR_INTERVAL_SECONDS=2
# 大屏折线图保留的采样点数（900 × 2s ≈ 30 分钟）
PRT_MONITOR_HISTORY_POINTS=900
PRT_LOG_TAIL_BYTES=200000
PRT_MAX_UPLOAD_MB=8192
# 任务是否必须经管理员审核才能运行
PRT_REQUIRE_APPROVAL=true
