# PRT AI DL Factory — 后端配置样例
# 复制为 backend/.env 后按实际环境修改；所有变量都以 PRT_ 开头。

# ---------------------------------------------------------------- 服务 ---
PRT_HOST=0.0.0.0
PRT_PORT=8000
PRT_DEBUG=false
# 逗号分隔的前端来源；开发时用 * 即可
PRT_CORS_ORIGINS=*

# ---------------------------------------------------------------- 账号 ---
# 留空则首次启动时自动生成并写入 data/db/secret.key
PRT_SECRET_KEY=
PRT_ACCESS_TOKEN_TTL_MINUTES=720
# 数据目录为空时自动创建的第一个管理员
PRT_BOOTSTRAP_ADMIN_EMAIL=admin@prt.local
PRT_BOOTSTRAP_ADMIN_PASSWORD=prt-admin-2026

# ---------------------------------------------------------------- 路径 ---
# 平台自身的数据（账号、任务、数据集、日志、产物）
PRT_DATA_ROOT=./data
# 模型仓库根目录，结构为 {厂家}/{模型名}
PRT_MODELS_ROOT=/workspace/LiHanlin_Workspace/models

# 训练/评测框架的源码位置
PRT_LLAMAFACTORY_ROOT=/workspace/LiHanlin_Workspace/github/LlamaFactory
PRT_VERL_ROOT=/workspace/LiHanlin_Workspace/github/verl
PRT_TRL_ROOT=/workspace/LiHanlin_Workspace/github/trl
PRT_HARBOR_ROOT=/workspace/LiHanlin_Workspace/github/harbor

# ------------------------------------------------------------ 解释器 -----
# 每个框架各自的 python（留空则使用 PRT_PYTHON_DEFAULT）。
# 训练框架依赖很重，通常各自装在独立的 conda 环境里。
PRT_PYTHON_DEFAULT=python
PRT_LLAMAFACTORY_PYTHON=
PRT_VERL_PYTHON=
PRT_TRL_PYTHON=
PRT_HARBOR_PYTHON=

# harbor / modelscope 命令行工具
# PRT_HARBOR_BIN 建议填绝对路径；只填裸名 harbor 时，平台会用 PRT_HARBOR_PYTHON
# 同目录下的 harbor（Harbor CLI 通常和它的解释器装在同一个 conda 环境里）。
PRT_HARBOR_BIN=harbor
PRT_MODELSCOPE_BIN=/opt/miniconda3/envs/modelscope/bin/modelscope

# ---------------------------------------------------------------- 调度 ---
# 同时运行的任务数（管理员可在系统设置里覆盖）
PRT_MAX_CONCURRENT_JOBS=2
PRT_SCHEDULER_INTERVAL_SECONDS=3
PRT_MONITOR_INTERVAL_SECONDS=2
# 大屏折线图保留的采样点数（900 × 2s ≈ 30 分钟）
PRT_MONITOR_HISTORY_POINTS=900
PRT_LOG_TAIL_BYTES=200000
# 单次上传大小上限（MB），0 表示不限制
PRT_MAX_UPLOAD_MB=0
# 任务是否必须经管理员审核才能运行
PRT_REQUIRE_APPROVAL=true

# ------------------------------------------------------------ 样例审核 ---
# 审核不占 GPU、不进调度队列，只消耗模型 API 额度，所以自己限流。
# 同时在跑的 subagent 数（一个质检项一个）
PRT_REVIEW_CONCURRENCY=4
# 一个 subagent 一次判定多少道题
PRT_REVIEW_BATCH_TASKS=20
# 单次审核最多受检题数
PRT_REVIEW_MAX_TASKS=500
# 每份证据文本（instruction.md / solve.sh …）送进 prompt 时的截断长度
PRT_REVIEW_EVIDENCE_BYTES=8000
# 一次请求里证据 JSON 的字符上限，超了就把题目批次再切小
PRT_REVIEW_BATCH_CHARS=60000
# 需求文档送进 prompt 的字数上限
PRT_REVIEW_MAX_DOC_CHARS=120000
PRT_REVIEW_LLM_TIMEOUT_SECONDS=300

# ---------------------------------------------------- 问题反馈（托管修复） ---
# 管理员点「托管 Agent 修复」后，平台把仓库 clone 到下面的目录（必须在仓库之外），
# 建 fix/issue-<id> 分支，用本机 Claude Code 修复并提交；合并时才动平台目录。
PRT_ISSUE_WORKSPACE_ROOT=~/prt-agent-workspaces
PRT_ISSUE_AGENT_BIN=claude
# 留空 = Claude Code 的默认模型
PRT_ISSUE_AGENT_MODEL=
PRT_ISSUE_AGENT_PERMISSION_MODE=acceptEdits
PRT_ISSUE_AGENT_TIMEOUT_SECONDS=3600
PRT_ISSUE_MAIN_BRANCH=main
PRT_ISSUE_PUSH_REMOTE=origin
# 合并后是否自动重启；PRT_ISSUE_RESTART_COMMAND 非空时改用它（例如 systemctl restart prt）
PRT_ISSUE_AUTO_RESTART=true
PRT_ISSUE_RESTART_COMMAND=
